# Copy to .env for local development:  cp .env.example .env
# Never commit .env.

# PostgreSQL connection. Local: docker compose up -d db. Production: Neon URL with ?sslmode=require
DATABASE_URL=postgres://chickaa:chickaa@localhost:5432/chickaa

# Public origin of the app (scheme + host, no trailing slash). Used for CSRF origin checks
# and invite links. Local dev through Vite: http://localhost:5173
PUBLIC_ORIGIN=http://localhost:5173

PORT=8080
NODE_ENV=development

# Apply database migrations when the server starts (the Docker image sets this to true).
RUN_MIGRATIONS_ON_START=true

# Optional: version string shown in the app (defaults to package version + git sha).
# APP_VERSION=
