{
  "name": "nochickencall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ncc/web --filter @ncc/api dev",
    "build": "pnpm --filter @ncc/web build && pnpm --filter @ncc/api build",
    "start": "pnpm --filter @ncc/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @ncc/db generate",
    "db:migrate": "pnpm --filter @ncc/db migrate",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "sharp": "^0.34.0"
  }
}
